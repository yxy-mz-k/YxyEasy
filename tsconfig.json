{
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "api/*": ["./src/api/*"],
      "assets/*": ["./src/assets/*"],
      "components/*": ["./src/components/*"],
      "design/*": ["./src/design/*"],
      "directives/*": ["./src/directives/*"],
      "enums/*": ["./src/enums/*"],
      "hooks/*": ["./src/hooks/*"],
      "layouts/*": ["./src/layouts/*"],
      "locales/*": ["./src/locales/*"],
      "logics/*": ["./src/logics/*"],
      "plugins/*": ["./src/plugins/*"],
      "router/*": ["./src/router/*"],
      "settings/*": ["./src/settings/*"],
      "store/*": ["./src/store/*"],
      "styles/*": ["./src/styles/*"],
      "types/*": ["./src/types/*"],
      "utils/*": ["./src/utils/*"],
      "views/*": ["./src/views/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "tests/**/*.jsx",
    "tests/**/*.d.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
